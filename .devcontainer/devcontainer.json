{
  "name": "Auto Claude Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },

  "mounts": [
    // Claude config mount (required for authentication)
    "source=${localEnv:HOME}/.config/claude,target=/home/node/.config/claude,type=bind,consistency=cached",
    // Cache npm dependencies for faster rebuilds
    "source=auto-claude-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=auto-claude-frontend-node-modules,target=${containerWorkspaceFolder}/apps/frontend/node_modules,type=volume",
    // Cache Python packages for faster rebuilds
    "source=auto-claude-python-venv,target=${containerWorkspaceFolder}/apps/backend/.venv,type=volume",
    // Cache UV and pip cache directories
    "source=auto-claude-uv-cache,target=/home/node/.cache/uv,type=volume",
    "source=auto-claude-pip-cache,target=/home/node/.cache/pip,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "saoudrizwan.claude-dev",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/apps/backend/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "ruff.lint.enable": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "[typescript]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[javascript]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[json]": {
          "editor.defaultFormatter": "biomejs.biome"
        }
      }
    }
  },

  "forwardPorts": [8000, 5173, 9222],
  "portsAttributes": {
    "8000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend Dev Server",
      "onAutoForward": "notify"
    },
    "9222": {
      "label": "Electron Remote Debug",
      "onAutoForward": "silent"
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "node",
  
  // Wait for extensions to be installed before running postCreateCommand
  "waitFor": "onCreateCommand",
  
  // Use updateContentCommand for faster subsequent rebuilds
  "updateContentCommand": "echo '📦 Updating dependencies...' && npm install --prefer-offline",
  
  // Lifecycle commands for optimization
  "onCreateCommand": "echo '🚀 Initial container setup...'",
  
  // Container settings for better performance
  "containerEnv": {
    "NPM_CONFIG_UPDATE_NOTIFIER": "false",
    "NPM_CONFIG_FUND": "false",
    "PYTHON_KEYRING_BACKEND": "keyring.backends.null.Keyring"
  }
}
